# Stellix Labs — backend configuration template.
#
# SETUP: copy this file to `backend/.env` and fill in the values below.
#   PowerShell:  Copy-Item backend\.env.example backend\.env
#
# `backend/.env` is gitignored and must NEVER be committed — it holds real secrets.
# Every key here maps to a field in `app/core/config.py`, which is the source of truth
# for defaults and validation.

# ---- Application -------------------------------------------------------------
# "development" | "production". Production enables extra safety checks (e.g. it
# refuses a wildcard CORS origin) and hides the dev-only reset/verification links.
ENVIRONMENT=development

# Comma-separated origins allowed to call the API from a browser.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Absolute base URL of the frontend. Used to build the links inside emails
# (verification, password reset, invitations) — must be the real public URL in
# production or every emailed link 404s.
FRONTEND_URL=http://localhost:3000

# ---- PostgreSQL + TimescaleDB ------------------------------------------------
# NOTE the port: this project uses 5433, not the default 5432.
# asyncpg driver — used by the running application.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5433/stellix_labs_dev
# psycopg driver — used by Alembic migrations. Same database, different driver.
DATABASE_URL_SYNC=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/stellix_labs_dev

# ---- Redis (cache + rate limiting + Celery broker + WebSocket pub/sub) --------
# Add a password as redis://:PASSWORD@127.0.0.1:6379/0 if your Redis requires one.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---- Research Memory -----------------------------------------------------------
# Lineage / failure memory is derived from Postgres inside the API process — there is
# no extra database to run. How often the index is rebuilt (seconds, minimum 30):
# RESEARCH_MEMORY_REFRESH_SECONDS=300

# ---- Auth --------------------------------------------------------------------
# Generate your own — any long random string. Changing it invalidates all
# existing sessions. Never reuse the value from another environment.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret

# =============================================================================
# EVERYTHING BELOW IS OPTIONAL.
# Each unset key simply disables its feature — the rest of the platform runs
# normally. This is the deferred-credential pattern used throughout the codebase.
# =============================================================================

# ---- LLM research assistant --------------------------------------------------
# Unset => the AI features (failure explanations, graph summaries) are unavailable.
# A cost router picks between the two providers; if one key is missing it falls
# back to the other.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Gemini key: Google AI Studio (https://aistudio.google.com/apikey) - it starts with "AIza".
# A Google Cloud key ("AQ.") will not work. After pasting it, run
#   backend\.venv\Scripts\python.exe scripts\llm_setup.py --use auto
# which tests the key, finds the Gemini models it can actually use, and sets the lines below.
GEMINI_API_KEY=
# Model names change: gemini-2.5-flash is no longer available to new keys (404). llm_setup.py
# discovers a working one; gemini-3.5-flash-lite worked on a fresh key in Oct 2026.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Multi-agent desk: TradingAgents (Batch 30, ADR 0009) -----------------------
# Provider: google (uses GEMINI_API_KEY) or anthropic (uses ANTHROPIC_API_KEY).
# scripts/llm_setup.py --use gemini|anthropic|auto rewrites these three lines for you.
AGENTS_LLM_PROVIDER=google
AGENTS_DEEP_MODEL=gemini-3.8-flash
AGENTS_QUICK_MODEL=gemini-3.5-flash-lite
AGENTS_MAX_DEBATE_ROUNDS=1
AGENTS_MAX_RISK_ROUNDS=1
AGENTS_HOLDING_DAYS=5
AGENTS_BACKTEST_MAX_CELLS=40
# Any other TradingAgents provider (openai, deepseek, groq, ollama, openai_compatible, ...)
# takes its key here; ollama / openai_compatible may be keyless.
AGENTS_LLM_API_KEY=
# Endpoint override; required for openai_compatible (vLLM, LM Studio, llama.cpp).
AGENTS_LLM_BACKEND_URL=
AGENTS_OUTPUT_LANGUAGE=English
# sec_edgar = US statements as filed on the analysis date; falls through to yfinance.
AGENTS_FUNDAMENTALS_VENDORS=sec_edgar,yfinance
# "Your Name you@example.com" — SEC asks callers to identify themselves.
SEC_EDGAR_USER_AGENT=
# Optional TypeSafe Jev screening of StockTwits/Reddit posts.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=
# Resume a retried run from the last finished agent.
AGENTS_CHECKPOINT_ENABLED=true

# ---- Market Terminal (Batch 31, ADR 0010) ----------------------------------------
# SEC_EDGAR_USER_AGENT above also enables SEC Form 4 insider data and market-cap
# sizing in the terminal (SEC requires callers to identify themselves).
# Risk-free rate for options Greeks when FRED DGS3MO is unavailable.
TERMINAL_RISK_FREE_RATE=0.04
# Live TV: JSON list of {"label","youtube_channel_id"} (official channels); empty = defaults.
TERMINAL_TV_CHANNELS=
TERMINAL_SOURCE_TIMEOUT_SECONDS=15
# Optional free CoinGecko Demo key; without it CoinGecko throttles and the crypto
# board falls back to Binance tickers (labelled).
COINGECKO_API_KEY=

# ---- Market data -------------------------------------------------------------
# Optional. yfinance is the default provider and needs NO key; this is only for
# the alternative Alpha Vantage provider. Free key: alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ---- Macro dashboard (FRED) ---------------------------------------------------
# Optional. Unset => the macro dashboard shows "not configured", never fabricated
# data. Free key (instant, no cost): create an account at fredaccount.stlouisfed.org
# then request a key at fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ---- Real-time US ETFs (Alpaca) ----------------------------------------------
# Optional. Unset => the dashboard's real-time ETF strip shows "not configured".
# Free "Basic" market-data plan: sign up at alpaca.markets, then generate an API
# key pair from the dashboard. Real-time trades from the IEX exchange, one
# websocket connection per account — run exactly one `python -m app.streaming.etf_stream`.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ---- Transactional email (SMTP) ----------------------------------------------
# Unset => every send is a logged no-op and verification / reset / invite links
# are returned in the API response instead, so local development needs no mail
# server at all. Any SMTP provider works.
# Gmail needs an App Password (2FA required), NOT your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Stellix Labs <no-reply@stellixlabs.com>
SMTP_STARTTLS=true

# ---- Billing (Stripe) --------------------------------------------------------
# Unset => every billing endpoint returns 503 "Billing not configured".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Observability -----------------------------------------------------------
# Unset => Sentry init is a no-op.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Notifications -----------------------------------------------------------
# Optional Discord/Slack-style incoming webhook for demo-request and
# registration alerts. The DB row is always written; the webhook is best-effort.
DEMO_WEBHOOK_URL=
