# Stellix Labs — backend configuration template.
#
# SETUP: copy this file to `backend/.env` and fill in the values below.
#   PowerShell:  Copy-Item backend\.env.example backend\.env
#
# `backend/.env` is gitignored and must NEVER be committed — it holds real secrets.
# Every key here maps to a field in `app/core/config.py`, which is the source of truth
# for defaults and validation.

# ---- Application -------------------------------------------------------------
# "development" | "production". Production enables extra safety checks (e.g. it
# refuses a wildcard CORS origin) and hides the dev-only reset/verification links.
ENVIRONMENT=development

# Comma-separated origins allowed to call the API from a browser.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Absolute base URL of the frontend. Used to build the links inside emails
# (verification, password reset, invitations) — must be the real public URL in
# production or every emailed link 404s.
FRONTEND_URL=http://localhost:3000

# ---- PostgreSQL + TimescaleDB ------------------------------------------------
# NOTE the port: this project uses 5433, not the default 5432.
# asyncpg driver — used by the running application.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5433/stellix_labs_dev
# psycopg driver — used by Alembic migrations. Same database, different driver.
DATABASE_URL_SYNC=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/stellix_labs_dev

# ---- Redis (cache + rate limiting + Celery broker + WebSocket pub/sub) --------
# Add a password as redis://:PASSWORD@127.0.0.1:6379/0 if your Redis requires one.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---- Neo4j (the knowledge graph) ---------------------------------------------
# Use bolt:// for a single local instance. neo4j:// performs cluster routing
# discovery, which is unnecessary locally and fails more noisily when the server
# is down. The app degrades gracefully if Neo4j is unreachable — only the
# Knowledge Graph page is affected.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# ---- Auth --------------------------------------------------------------------
# Generate your own — any long random string. Changing it invalidates all
# existing sessions. Never reuse the value from another environment.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret

# =============================================================================
# EVERYTHING BELOW IS OPTIONAL.
# Each unset key simply disables its feature — the rest of the platform runs
# normally. This is the deferred-credential pattern used throughout the codebase.
# =============================================================================

# ---- LLM research assistant --------------------------------------------------
# Unset => the AI features (failure explanations, graph summaries) are unavailable.
# A cost router picks between the two providers; if one key is missing it falls
# back to the other.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Market data -------------------------------------------------------------
# Optional. yfinance is the default provider and needs NO key; this is only for
# the alternative Alpha Vantage provider. Free key: alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ---- Transactional email (SMTP) ----------------------------------------------
# Unset => every send is a logged no-op and verification / reset / invite links
# are returned in the API response instead, so local development needs no mail
# server at all. Any SMTP provider works.
# Gmail needs an App Password (2FA required), NOT your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Stellix Labs <no-reply@stellixlabs.com>
SMTP_STARTTLS=true

# ---- Billing (Stripe) --------------------------------------------------------
# Unset => every billing endpoint returns 503 "Billing not configured".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Observability -----------------------------------------------------------
# Unset => Sentry init is a no-op.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Notifications -----------------------------------------------------------
# Optional Discord/Slack-style incoming webhook for demo-request and
# registration alerts. The DB row is always written; the webhook is best-effort.
DEMO_WEBHOOK_URL=
