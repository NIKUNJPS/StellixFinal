# =============================================================================
# Stellix Labs — environment template.
#
# Copy this file to `.env` (in /infra) and fill in real values:
#     cp .env.example .env
#
# NOTHING here is a real secret. NEVER commit a populated `.env`.
# The backend reads the same variables (see backend/app/core/config.py).
# =============================================================================

# ---- PostgreSQL + TimescaleDB ----------------------------------------------
POSTGRES_USER=stellix
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=stellix
POSTGRES_PORT=5432
# Host used by the BACKEND to reach Postgres.
#   - From your host machine / local backend process: localhost
#   - From another container on the compose network:  postgres
POSTGRES_HOST=localhost

# Async SQLAlchemy URL (asyncpg driver). Derived from the values above; keep in sync.
DATABASE_URL=postgresql+asyncpg://stellix:change-me-postgres@localhost:5432/stellix
# Sync URL used by Alembic migrations (psycopg driver).
DATABASE_URL_SYNC=postgresql+psycopg://stellix:change-me-postgres@localhost:5432/stellix

# ---- Redis 7.x (cache, sessions, Celery broker) ----------------------------
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
# Redis URL used by the backend and Celery.
#   - From host / local backend: redis://:<pwd>@localhost:6379/0
#   - From another container:     redis://:<pwd>@redis:6379/0
REDIS_URL=redis://:change-me-redis@localhost:6379/0

# Celery uses dedicated logical DBs to avoid colliding with the cache (DB 0).
CELERY_BROKER_URL=redis://:change-me-redis@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:change-me-redis@localhost:6379/2

# ---- Auth / JWT -------------------------------------------------------------
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (the frontend dev server).
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---- Frontend ---------------------------------------------------------------
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Observability (Batch 13) -----------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Discord/Slack incoming-webhook URL (or any HTTP endpoint) Grafana posts
# alerts to. Optional — unset means the 3 provisioned alert rules still
# evaluate, they just have nowhere to notify until this is supplied.
GRAFANA_ALERT_WEBHOOK_URL=

# ---- Transactional email / SMTP (Batch 25) ----------------------------------
# Powers: email verification on registration, password-reset links, team
# invitations, org approval/suspension/termination notices, and the weekly digest.
#
# DEFERRED CREDENTIAL — leave these blank and the whole platform still works:
# every send becomes a logged no-op and the API hands the link back in the
# response instead (dev_verification_link / dev_reset_link / dev_invite_link),
# so you can walk every flow locally with no mail server at all. Filling them in
# is what switches delivery on; the dev_* fields then disappear automatically.
#
# Any SMTP provider works. Gmail example (requires 2FA + an App Password, NOT
# your normal account password — https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM=Stellix Labs <you@gmail.com>
# Provider SMTP endpoints (SendGrid/Mailgun/Resend/Zoho) drop in the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From: header. Most providers require this to be a verified sender.
SMTP_FROM=Stellix Labs <no-reply@stellixlabs.com>
# STARTTLS on port 587 (the common default). For implicit TLS use port 465 and
# set SMTP_STARTTLS=false.
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Absolute base URL used to build the links inside those emails. MUST be the
# public URL of the frontend in production, or every emailed link will 404.
FRONTEND_URL=http://localhost:3000
