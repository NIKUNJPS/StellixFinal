{
  // Each task opens its own dedicated terminal panel and stays running.
  // Run everything at once with:  Terminal > Run Task... > "▶ Run All (dev)"
  // (or Ctrl+Shift+P -> "Tasks: Run Task").
  "version": "2.0.0",
  "tasks": [
    // --- One-command launcher (scripts/dev_up.ps1): preflight + migrations + every service
    // in its own window, including the scheduler (beat) the "Run All" task below omits.
    {
      "label": "Stellix: START EVERYTHING (web on :3001)",
      "detail": "Use this while another project holds port 3000.",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/dev_up.ps1 -FrontendPort 3001",
      "problemMatcher": []
    },
    {
      "label": "Stellix: START EVERYTHING (web on :3000)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/dev_up.ps1",
      "problemMatcher": []
    },
    {
      "label": "Stellix: RESTART everything (web on :3001) - use after editing .env",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/dev_up.ps1 -FrontendPort 3001 -Restart",
      "problemMatcher": []
    },
    {
      "label": "Stellix: STOP everything",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/dev_up.ps1 -Stop",
      "problemMatcher": []
    },
    {
      "label": "Stellix: preflight check only (starts nothing)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/dev_up.ps1 -CheckOnly",
      "problemMatcher": []
    },
    {
      "label": "backend: uvicorn (:8000)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "stellix", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "frontend: next dev (:3000)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "group": "stellix", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "celery: worker (solo pool for Windows)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m celery -A app.worker.celery_app.celery_app worker --loglevel=INFO --pool=solo",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "stellix", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "celery: realtime worker (market data)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m celery -A app.worker.celery_app.celery_app worker -Q realtime -n realtime@%h --loglevel=INFO --pool=solo",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "stellix", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "stream: real-time ETFs (Alpaca — needs ALPACA_* keys)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m app.streaming.etf_stream",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "stellix", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "celery: beat (scheduled tasks — optional)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m celery -A app.worker.celery_app.celery_app beat --loglevel=INFO",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "stellix", "panel": "dedicated" },
      "problemMatcher": []
    },

    {
      "label": "▶ Run All (dev)",
      "dependsOn": [
        "backend: uvicorn (:8000)",
        "frontend: next dev (:3000)",
        "celery: worker (solo pool for Windows)",
        "celery: realtime worker (market data)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },

    {
      "label": "setup: pip install (backend deps)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m pip install -r requirements.txt -r requirements-dev.txt",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "setup: alembic upgrade head (migrate DB)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m alembic upgrade head",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "setup: seed Meridian demo data",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe ../scripts/seed_demo_data.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "npm install (frontend deps)",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}
