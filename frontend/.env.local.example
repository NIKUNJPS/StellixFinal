# Copy to `.env.local`. Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Observability (Batch 13). Optional — Sentry is inert (no-op init) when unset,
# same deferred-credential pattern as the backend's SENTRY_DSN. NEXT_PUBLIC_
# because the browser-side capture needs it baked into the client bundle; the
# server/edge configs read the same var (any server-side env var is readable
# server-side regardless of the NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SENTRY_DSN=

# Optional, build-time only — enables next.config.mjs's sourcemap upload step.
# A separate credential from the DSN above; leave unset to build without it.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
